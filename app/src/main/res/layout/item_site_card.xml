<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="12dp"
    app:cardBackgroundColor="@color/surface_card"
    app:strokeColor="@color/border_light"
    app:strokeWidth="1dp"
    app:cardElevation="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <TextView
                android:id="@+id/tvSiteRegionBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_navy"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="GREATER ACCRA"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSiteType"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Tier-3 Data Center"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSiteSweepsCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="42 Audits"
                android:textColor="@color/teal_600"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvSiteName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Accra Central Data Center"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvSiteAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📍 Plot 14, Ring Road Central, Accra"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#F8FAFC"
            android:padding="8dp">

            <TextView
                android:id="@+id/tvSiteContact"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Contact: Kwame Addo (+233 24 412 3456)"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStartSiteSweep"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Start Audit"
                android:textColor="@color/navy_900"
                android:textSize="11sp"
                android:textStyle="bold"
                android:insetTop="0dp"
                android:insetBottom="0dp" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>