<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="12dp"
    app:cardBackgroundColor="@color/surface_card"
    app:strokeColor="@color/border_light"
    app:strokeWidth="1dp"
    app:cardElevation="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Section Tag -->
        <TextView
            android:id="@+id/tvChecklistSectionTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ACCESS CONTROL &amp; PERIMETER"
            android:textColor="@color/teal_600"
            android:textSize="10sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <!-- Title -->
        <TextView
            android:id="@+id/tvChecklistTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Perimeter Fencing &amp; Main Gates"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <!-- Field Operational Prompt Text -->
        <TextView
            android:id="@+id/tvChecklistPrompt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Inspect outer fence line, razor wire integrity, anti-climb barriers, and main vehicle gate locking mechanisms."
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:layout_marginBottom="12dp" />

        <!-- Status Toggle Selector (Pass / Issue / N/A) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStatusPass"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="✓ Pass"
                android:textColor="@color/pass_green"
                app:strokeColor="@color/pass_green"
                android:textSize="12sp"
                android:textStyle="bold"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:layout_marginEnd="4dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStatusIssue"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="⚠ Issue"
                android:textColor="@color/issue_red"
                app:strokeColor="@color/issue_red"
                android:textSize="12sp"
                android:textStyle="bold"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:layout_marginHorizontal="2dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStatusNA"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="N/A"
                android:textColor="@color/neutral_slate"
                app:strokeColor="@color/border_light"
                android:textSize="12sp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <!-- Notes / Observations Input -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilChecklistNotes"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Field Notes &amp; Observations..."
            app:boxCornerRadiusTopStart="8dp"
            app:boxCornerRadiusTopEnd="8dp"
            app:boxCornerRadiusBottomStart="8dp"
            app:boxCornerRadiusBottomEnd="8dp"
            android:layout_marginBottom="8dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etChecklistNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine"
                android:maxLines="2"
                android:textSize="12sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Linked Action Row: Attach Photo & Log Finding -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddChecklistPhoto"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Attach Photo (0)"
                android:textColor="@color/navy_900"
                app:icon="@drawable/ic_camera"
                app:iconTint="@color/navy_900"
                android:textSize="11sp"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogFinding"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Log Finding"
                android:textColor="@color/issue_red"
                app:icon="@drawable/ic_findings"
                app:iconTint="@color/issue_red"
                android:textSize="11sp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- Linked Finding Summary Chip if present -->
        <TextView
            android:id="@+id/tvLinkedFindingChip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_issue"
            android:padding="8dp"
            android:text="Finding Logged: Emergency Exit Panic Hardware Lock Stiff (HIGH Severity)"
            android:textColor="@color/issue_red"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone"
            android:layout_marginTop="6dp" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>