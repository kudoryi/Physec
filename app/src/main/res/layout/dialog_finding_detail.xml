<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Title -->
        <TextView
            android:id="@+id/tvModalFindingTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Emergency Exit Panic Hardware Lock Stiff"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvModalFindingSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Accra Central Data Center • Due 28/10/2024"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:layout_marginBottom="14dp" />

        <!-- Severity & Assigned Team Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tvModalSeverity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_issue"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="HIGH SEVERITY"
                android:textColor="@color/issue_red"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvModalTeam"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Team: Facilities &amp; Maintenance"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvModalDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Description of issue..."
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:layout_marginBottom="14dp" />

        <!-- Status Selector Dropdown -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Update Finding Status*"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <Spinner
            android:id="@+id/spFindingStatus"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_card_border"
            android:paddingHorizontal="10dp"
            android:layout_marginBottom="14dp" />

        <!-- Resolution Notes -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Resolution Notes / Remediation Actions Taken"
            android:layout_marginBottom="14dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etResolutionNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine"
                android:minLines="2"
                android:textSize="13sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Follow-up Photo Evidence Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddFollowUpPhoto"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="Attach Resolution Photo"
            android:textColor="@color/navy_900"
            app:icon="@drawable/ic_camera"
            app:iconTint="@color/navy_900"
            app:strokeColor="@color/border_light"
            android:layout_marginBottom="16dp" />

        <!-- Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelDetail"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cancel"
                android:textColor="@color/text_secondary"
                android:layout_marginEnd="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveFindingStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Save Status"
                android:textColor="@color/white"
                android:textStyle="bold"
                app:backgroundTint="@color/blue_600" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>