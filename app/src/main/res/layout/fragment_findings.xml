<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_light"
    android:padding="16dp">

    <!-- Header -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Findings &amp; Action Tracker"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvFindingsSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Track physical security and safety issues across all Ghanaian telecom sites"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:layout_marginBottom="12dp" />

    <!-- Filter Chips -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginBottom="12dp">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupFindingsFilter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipFindingAll"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="All Findings" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipFindingOpen"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Open &amp; In Progress" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipFindingHighPriority"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="High &amp; Critical" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipFindingResolved"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Resolved / Closed" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- Findings RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvFindingsList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/tvNoFindingsMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No findings match the selected filter."
        android:textColor="@color/text_muted"
        android:textSize="14sp"
        android:gravity="center"
        android:visibility="gone"
        android:padding="24dp" />

</LinearLayout>